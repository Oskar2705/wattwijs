# Energiemonitor configuration. Copy to .env and fill in what applies to your home.
# Every setting is optional; leave a device empty if you don't have it.

# ===== General =====
SITE_NAME=Thuis
TZ=Europe/Amsterdam
# Port on the host (docker compose)
HOST_PORT=8000
# Address where the app is reachable (used for links in mails and notifications)
APP_URL=http://192.168.1.50:8000
# 1 = try the app with simulated data, no devices needed. Set to 0 for your own home.
DEMO=1
# Optional password. Required if the app is reachable outside your home network.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ===== Which integration per role (optional) =====
# Leave empty to pick automatically from the device settings below.
# See README.md for all available keys, or GET /api/integrations. Use "none" to disable a role.
GRID_INTEGRATION=
BATTERY_INTEGRATION=
SOLAR_INTEGRATION=
HEATPUMP_INTEGRATION=
AIRCON_INTEGRATION=
PANELS_INTEGRATION=
PRICES_INTEGRATION=

# ===== Smart meter via a P1 dongle =====
# IP address of the dongle (give it a fixed DHCP reservation)
P1_HOST=
# smeter (SMeter-RS06 / AECC) or homewizard
P1_TYPE=smeter
# Set to 1 if import and export turn out to be swapped
GRID_INVERT=0

# ===== Home battery on the AECC platform (Voltdeer, Sunpura, Lunergy, AEG, ...) =====
# Local TCP, read only. Leave empty if you have no battery.
BATTERY_HOST=
BATTERY_PORT=8080

# ===== SolarEdge =====
# Live production via Modbus TCP (recommended, enable port 1502 via SetApp).
# Empty = live production via the monitoring portal (refreshes every 2 minutes).
SOLAREDGE_MODBUS_HOST=
SOLAREDGE_MODBUS_PORT=1502
# Login for monitoring.solaredge.com (needed for per-panel yield)
SOLAREDGE_USERNAME=
SOLAREDGE_PASSWORD=
# Site ID: the number in the address bar of the monitoring portal
SOLAREDGE_SITE_ID=

# ===== DeWarmte heat pump (login of mydewarmte.com) =====
DEWARMTE_USERNAME=
DEWARMTE_PASSWORD=

# ===== Air conditioners: Mitsubishi Heavy with WF-RAC wifi module (Smart M-Air app) =====
# One entry per indoor unit: Name=ip or Name=ip:port (default port 51443), separated by ';'.
# The names are shown in the app. Give each unit a fixed DHCP reservation.
# Example: AIRCO_UNITS=Living room=192.168.1.40;Bedroom=192.168.1.41
AIRCO_UNITS=
# 1 = on/off, mode and temperature can be changed in the Airco tab; 0 = read only
AIRCO_CONTROL=1
AIRCO_POLL_SECONDS=60
# Estimated power of a running compressor until the unit has reported its first 0.25 kWh step
AIRCO_DEFAULT_W=500

# ===== Per-panel check =====
# Physical layout as shown in the SolarEdge portal: rows separated by ';',
# panels left to right separated by ','. Without a layout only dead panels are reported.
# Example: PANEL_LAYOUT=1.1.1,1.1.2,1.1.3;1.1.6,1.1.5,1.1.4
PANEL_LAYOUT=
PANEL_THRESHOLD_PERCENT=20
PANEL_CONSECUTIVE_DAYS=2
PANEL_MIN_REFERENCE_WH=100
PANEL_CHECK_TIME=21:30
# How often today's per-panel yield is fetched during the day (minutes, min. 5)
PANEL_REFRESH_MINUTES=15
PANEL_RECOVERY_MAIL=1
PANEL_BACKFILL_DAYS=14
# Days used to learn what is "normal" for each panel
PANEL_BASELINE_DAYS=30
# Less than this share of the other panels = dead (always reported)
PANEL_DEAD_SHARE=0.25

# ===== Dynamic electricity prices (Frank Energie public API, no login) =====
PRICES_ENABLED=1
# Date your dynamic contract starts; amounts before this date are shown as an indication
CONTRACT_START=2027-01-01
# Feed-in price = market price x EXPORT_MULTIPLIER + EXPORT_FEE_EUR (per kWh).
# Take the purchase fee from your contract.
EXPORT_MULTIPLIER=1.0
EXPORT_FEE_EUR=0.0
# Mail ALERT_TO when tomorrow has negative prices
PRICE_NEGATIVE_MAIL=1
PRICE_BACKFILL_DAYS=62

# ===== Push notifications (home screen web app, also on iPhone) =====
PUSH_ENABLED=1
# Contact address sent to the push service of Apple/Google (required in every message)
PUSH_CONTACT=
# Morning tip: cheapest time slot, yesterday in short, a broken panel
PUSH_MORNING_TIME=07:30
# Evening: daily record, (almost) self-sufficient day or milestone
PUSH_EVENING_TIME=20:30
# Weekly summary on Sunday
PUSH_WEEKLY_TIME=19:00
# Length of the cheapest block in hours, and the hours it may fall in
PUSH_BLOCK_HOURS=2
PUSH_BLOCK_WINDOW=07:00-23:00

# ===== Mail =====
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Recipients of panel alerts, comma separated
ALERT_TO=
# Recipient of technical alerts (device offline)
ADMIN_TO=
OFFLINE_ALERT_MINUTES=120
